#!/usr/bin/env bash
# Herramienta segura de recuperación y restauración offline de IA Workspace. Ver --help.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPYCACHEPREFIX="${PYTHONPYCACHEPREFIX:-$ROOT/var/pycache}"
exec python3 -m ia_workspace.restore_cli "$@"
